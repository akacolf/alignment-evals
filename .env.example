# ==========================================
# Alignment Evals Configuration
# All of these are optional depending on your chosen provider.
# You only need ONE provider to run experiments!
# ==========================================

# 1. 100% Free Cloud Providers (Recommended for zero-cost runs)
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Get a free key at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Local 100% Free Provider (Ollama: https://ollama.com)
OLLAMA_BASE_URL=http://localhost:11434/v1

# 3. Commercial Paid Providers (Optional)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Default provider to use: 'groq', 'gemini', 'ollama', 'anthropic', 'openai', or 'mock'
DEFAULT_PROVIDER=groq
