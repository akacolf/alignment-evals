# ==========================================
# Alignment Weekend Evals Configuration
# All of these are optional depending on your chosen provider.
# You only need ONE provider to run experiments!
# ==========================================

# 1. 100% Free Cloud Providers (Recommended for $0 spend)
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=

# Get a free key at https://aistudio.google.com/
GEMINI_API_KEY=

# 2. Local 100% Free Provider (Ollama: https://ollama.com)
OLLAMA_BASE_URL=http://localhost:11434/v1

# 3. Commercial Paid Providers (Optional)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Default provider to use: 'groq', 'gemini', 'ollama', 'anthropic', or 'openai'
DEFAULT_PROVIDER=groq
